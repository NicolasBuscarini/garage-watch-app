# Copie para .env e ajuste os valores ao host. Não inclua credenciais.
APP_PORT=8080
APP_UID=1000
APP_GID=1000
VIDEO_GID=44
HOST_DATA_DIR=./data
CAMERA_DEVICE_PATH=/dev/video0
CAMERA_ID=garage-01
RECORD_AUDIO=false
FRAME_WIDTH=640
FRAME_HEIGHT=480
FRAME_RATE=10
SEGMENT_SECONDS=2
SEGMENT_RETENTION_SECONDS=15
PRE_EVENT_SECONDS=10
POST_EVENT_SECONDS=20
STORAGE_QUOTA_BYTES=5368709120
MIN_FREE_BYTES=536870912
CAPTURE_RETRY_SECONDS=2
MAX_PENDING_CLIPS=5
MAX_CLIP_BYTES=268435456
